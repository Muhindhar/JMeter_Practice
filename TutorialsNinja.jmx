            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor - Capitalize">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">String keyword = vars.get(&quot;keyword&quot;);

if (keyword != null &amp;&amp; keyword.length() &gt; 0) {
    keyword = keyword.substring(0,1).toUpperCase() + keyword.substring(1).toLowerCase();
    vars.put(&quot;keyword&quot;, keyword);
}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor - ID">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">String response = prev.getResponseDataAsString();

java.util.regex.Pattern pattern =
java.util.regex.Pattern.compile(&quot;product_id=(\\d+)&quot;);

java.util.regex.Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    vars.put(&quot;productId&quot;, matcher.group(1));
    log.info(&quot;Product ID = &quot; + matcher.group(1));
} else {
    vars.put(&quot;productId&quot;, &quot;0&quot;);
    log.info(&quot;Product ID not found&quot;);
}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
          </hashTree>
