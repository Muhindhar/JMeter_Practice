            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.*;

String response = prev.getResponseDataAsString();


Pattern pattern = Pattern.compile(&quot;workingItemId=([A-Z0-9\\-]+)&quot;);
Matcher matcher = pattern.matcher(response);

ArrayList itemList = new ArrayList();

while (matcher.find()) {

    String item = matcher.group(1);

    if (!itemList.contains(item)) {
        itemList.add(item);
    }
}

if (itemList.size() &gt; 0) {

    log.info(&quot;========== Working Item List ==========&quot;);

    for (int i = 0; i &lt; itemList.size(); i++) {
        log.info((i + 1) + &quot;. &quot; + itemList.get(i));
    }

    Random random = new Random();

    String selectedItem =
        (String) itemList.get(random.nextInt(itemList.size()));

    vars.put(&quot;workingItemId&quot;, selectedItem);

    log.info(&quot;---------------------------------------&quot;);
    log.info(&quot;Selected Working Item ID : &quot; + selectedItem);
    log.info(&quot;---------------------------------------&quot;);

} else {

    log.error(&quot;No Working Item IDs Found!&quot;);

}</stringProp>
            </BeanShellPreProcessor>
