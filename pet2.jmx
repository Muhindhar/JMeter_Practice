        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC_VALIDATE_CART">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell Sampler - Validate Cart">
            <stringProp name="BeanShellSampler.query">String workingItemId = vars.get(&quot;workingItemId&quot;);

if (workingItemId != null &amp;&amp; workingItemId.length() &gt; 0) {
    vars.put(&quot;cartValid&quot;, &quot;true&quot;);
    log.info(&quot;Cart validated. workingItemId = &quot; + workingItemId);
} else {
    vars.put(&quot;cartValid&quot;, &quot;false&quot;);
    log.info(&quot;Cart validation failed - workingItemId not set&quot;);
}

if (vars.get(&quot;retryCount&quot;) == null) {
    vars.put(&quot;retryCount&quot;, &quot;0&quot;);
}

SampleResult.setResponseData((&quot;cartValid=&quot; + vars.get(&quot;cartValid&quot;)).getBytes());
SampleResult.setSuccessful(true);</stringProp>
          </BeanShellSampler>
          <hashTree/>
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="While Controller - Retry Until Cart Valid">
            <stringProp name="WhileController.condition">&quot;${cartValid}&quot;.equals(&quot;false&quot;) &amp;&amp; Integer.parseInt(&quot;${retryCount}&quot;) &lt; 3</stringProp>
          </WhileController>
          <hashTree>
            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell Sampler - Retry Cart Check">
              <stringProp name="BeanShellSampler.query">int retryCount = Integer.parseInt(vars.get(&quot;retryCount&quot;));
retryCount++;
vars.put(&quot;retryCount&quot;, String.valueOf(retryCount));
log.info(&quot;Retry attempt #&quot; + retryCount + &quot; - rechecking cart...&quot;);

String workingItemId = vars.get(&quot;workingItemId&quot;);

if (workingItemId != null &amp;&amp; workingItemId.length() &gt; 0) {
    vars.put(&quot;cartValid&quot;, &quot;true&quot;);
    log.info(&quot;Cart is now valid on retry #&quot; + retryCount);
} else {
    log.info(&quot;Cart still invalid on retry #&quot; + retryCount);
}

SampleResult.setResponseData((&quot;retry=&quot; + retryCount + &quot;, cartValid=&quot; + vars.get(&quot;cartValid&quot;)).getBytes());
SampleResult.setSuccessful(true);</stringProp>
            </BeanShellSampler>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Controller - Proceed To Checkout">
            <stringProp name="IfController.condition">&quot;${cartValid}&quot;.equals(&quot;true&quot;)</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell Sampler - Log Proceeding">
              <stringProp name="BeanShellSampler.query">log.info(&quot;Cart validated successfully. Proceeding to checkout with workingItemId = &quot; + vars.get(&quot;workingItemId&quot;));
SampleResult.setResponseData(&quot;Proceeding to checkout&quot;.getBytes());
SampleResult.setSuccessful(true);</stringProp>
            </BeanShellSampler>
            <hashTree/>
          </hashTree>
        </hashTree>
