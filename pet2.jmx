            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.*;

String response = prev.getResponseDataAsString();


Pattern pattern = Pattern.compile(&quot;productId=([A-Z0-9\\-]+)&quot;);
Matcher matcher = pattern.matcher(response);

ArrayList productList = new ArrayList();

while (matcher.find()) {

    String product = matcher.group(1);

   
    if (!productList.contains(product)) {
        productList.add(product);
    }
}

if (productList.size() &gt; 0) {

    log.info(&quot;========== Product List ==========&quot;);

    for (int i = 0; i &lt; productList.size(); i++) {
        log.info((i + 1) + &quot;. &quot; + productList.get(i));
    }

    Random random = new Random();

    String randomProduct =
        (String) productList.get(random.nextInt(productList.size()));

    vars.put(&quot;productId&quot;, randomProduct);

    log.info(&quot;----------------------------------&quot;);
    log.info(&quot;Selected Product ID : &quot; + randomProduct);
    log.info(&quot;----------------------------------&quot;);

} else {

    log.error(&quot;No Product IDs Found!&quot;);

}</stringProp>
            </BeanShellPreProcessor>
