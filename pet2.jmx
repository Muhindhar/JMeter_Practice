            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import java.util.regex.*;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;([A-Za-z0-9_-]{50,})&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    String token = matcher.group(1);
    vars.put(&quot;token&quot;, token);
    log.info(&quot;Extracted Token: &quot; + token);
} else {
    log.info(&quot;Token not found!&quot;);
}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;name=\&quot;_sourcePage\&quot;\\s+value=\&quot;([^\&quot;]+)\&quot;&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {

    String sourcePage = matcher.group(1);

    vars.put(&quot;sourcePage&quot;, sourcePage);

    log.info(&quot;=================================&quot;);
    log.info(&quot;Source Page = &quot; + sourcePage);
    log.info(&quot;=================================&quot;);

} else {

    log.error(&quot;_sourcePage not found!&quot;);

}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.Random;

Random r = new Random();

String[] firstNames = {&quot;Muhindhar&quot;,&quot;Arun&quot;,&quot;Karthik&quot;,&quot;Rahul&quot;,&quot;Vignesh&quot;,&quot;Ajay&quot;,&quot;Praveen&quot;,&quot;Hari&quot;,&quot;Surya&quot;,&quot;Rohit&quot;};
String[] lastNames = {&quot;sv&quot;,&quot;Kumar&quot;,&quot;Raj&quot;,&quot;Sharma&quot;,&quot;Patel&quot;,&quot;Reddy&quot;,&quot;Singh&quot;,&quot;Babu&quot;,&quot;Mohan&quot;,&quot;Das&quot;};
String[] address = {&quot;Anna Nagar&quot;,&quot;Vinayagampatti&quot;,&quot;MG Road&quot;,&quot;Gandhi Street&quot;,&quot;Nehru Nagar&quot;,&quot;Lake View&quot;,&quot;Park Avenue&quot;,&quot;Main Road&quot;};
String[] cities = {&quot;Salem&quot;,&quot;Chennai&quot;,&quot;Coimbatore&quot;,&quot;Madurai&quot;,&quot;Trichy&quot;,&quot;Bangalore&quot;,&quot;Hyderabad&quot;};
String[] states = {&quot;Tamil Nadu&quot;,&quot;Karnataka&quot;,&quot;Kerala&quot;,&quot;Andhra Pradesh&quot;,&quot;Telangana&quot;};

vars.put(&quot;billFirstName&quot;, firstNames[r.nextInt(firstNames.length)]);
vars.put(&quot;billLastName&quot;, lastNames[r.nextInt(lastNames.length)]);
vars.put(&quot;billAddress1&quot;, address[r.nextInt(address.length)]);
vars.put(&quot;billAddress2&quot;, address[r.nextInt(address.length)]);
vars.put(&quot;billCity&quot;, cities[r.nextInt(cities.length)]);
vars.put(&quot;billState&quot;, states[r.nextInt(states.length)]);
vars.put(&quot;billCountry&quot;, &quot;India&quot;);
vars.put(&quot;billZip&quot;, String.valueOf(600000 + r.nextInt(99999)));

String card =
(1000 + r.nextInt(9000)) + &quot; &quot; +
(1000 + r.nextInt(9000)) + &quot; &quot; +
(1000 + r.nextInt(9000)) + &quot; &quot; +
(1000 + r.nextInt(9000));

vars.put(&quot;creditCard&quot;, card);

int month = r.nextInt(12) + 1;
int year = r.nextInt(10) + 26;

String mm = (month &lt; 10) ? &quot;0&quot; + month : &quot;&quot; + month;
String expiry = mm + &quot;/&quot; + year;

vars.put(&quot;expiryDate&quot;, expiry);

log.info(&quot;Expiry : &quot; + expiry);</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
