            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.*;

String response = prev.getResponseDataAsString();

// Extract categoryId dynamically from HTML
Pattern p = Pattern.compile(&quot;categoryId=([A-Z]+)&quot;);
Matcher m = p.matcher(response);

ArrayList categories = new ArrayList();

while (m.find()) {
    String category = m.group(1);

    if (!categories.contains(category)) {
        categories.add(category);
    }
}

if (categories.size() &gt; 0) {

    log.info(&quot;========== Available Categories ==========&quot;);

    for (int i = 0; i &lt; categories.size(); i++) {
        log.info((i + 1) + &quot;. &quot; + categories.get(i));
    }

    Random random = new Random();
    int index = random.nextInt(categories.size());

    String selectedCategory = (String) categories.get(index);

    vars.put(&quot;categoryId&quot;, selectedCategory);

    log.info(&quot;------------------------------------------&quot;);
    log.info(&quot;Selected Category : &quot; + selectedCategory);
    log.info(&quot;------------------------------------------&quot;);

} else {
    log.error(&quot;No Categories Found!&quot;);
}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion">
              <stringProp name="BeanShellAssertion.query">String response = prev.getResponseDataAsString();

String category = vars.get(&quot;categoryId&quot;);


String expected = category.substring(0,1).toUpperCase() +
                  category.substring(1).toLowerCase();

if (response.contains(expected)) {
    Failure = false;
    log.info(&quot;PASS: &apos;&quot; + expected + &quot;&apos; is present in the response.&quot;);
} else {
    Failure = true;
    FailureMessage = &quot;FAIL: &apos;&quot; + expected + &quot;&apos; is NOT present in the response.&quot;;
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
