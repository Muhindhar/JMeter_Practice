            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="Category" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.ArrayList;
import java.util.Random;

// Get the previous sampler response
String response = prev.getResponseDataAsString();

// Regex to extract categoryId values
Pattern pattern = Pattern.compile(&quot;categoryId=([A-Z]+)&quot;);
Matcher matcher = pattern.matcher(response);

// Store unique category IDs
ArrayList categoryList = new ArrayList();

while (matcher.find()) {
    String category = matcher.group(1);

    if (!categoryList.contains(category)) {
        categoryList.add(category);
    }
}

// Check if categories were found
if (categoryList.size() &gt; 0) {

    // Convert to array
    String[] categoryArray = new String[categoryList.size()];
    categoryList.toArray(categoryArray);

    // Pick random category
    Random random = new Random();
    String randomCategory = categoryArray[random.nextInt(categoryArray.length)];

    // Store in JMeter variable
    vars.put(&quot;randomCategoryId&quot;, randomCategory);

    log.info(&quot;Available Categories: &quot; + categoryList);
    log.info(&quot;Selected Category: &quot; + randomCategory);

} else {
    log.error(&quot;No category IDs found.&quot;);
}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
