            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;
import java.util.ArrayList;
import java.util.Random;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;productId=([A-Za-z0-9-]+)&quot;);
Matcher matcher = pattern.matcher(response);

ArrayList productIds = new ArrayList();

while (matcher.find()) {

    String productId = matcher.group(1);

    if (!productIds.contains(productId)) {
        productIds.add(productId);
    }
}

if (!productIds.isEmpty()) {

    Random random = new Random();

    String randomProductId =
        (String) productIds.get(random.nextInt(productIds.size()));

    vars.put(&quot;randomProductId&quot;, randomProductId);

    log.info(&quot;Available Product IDs: &quot; + productIds);
    log.info(&quot;Selected Product ID: &quot; + randomProductId);

} else {

    vars.put(&quot;randomProductId&quot;, &quot;&quot;);

    log.error(&quot;No productId values found in the response&quot;);
}</stringProp>
            </BeanShellPostProcessor>
