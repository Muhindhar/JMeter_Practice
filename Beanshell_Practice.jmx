            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="Source_fp1" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;

String response = prev.getResponseDataAsString();

// Extract _sourcePage
Pattern sourcePattern = Pattern.compile(&quot;name=\&quot;_sourcePage\&quot;\\s+value=\&quot;([^\&quot;]+)\&quot;&quot;);
Matcher sourceMatcher = sourcePattern.matcher(response);

if (sourceMatcher.find()) {
    String sourcePage = sourceMatcher.group(1);
    vars.put(&quot;sourcePage1&quot;, sourcePage);
    log.info(&quot;Extracted _sourcePage: &quot; + sourcePage);
} else {
    log.info(&quot;_sourcePage value not found&quot;);
}

// Extract __fp
Pattern fpPattern = Pattern.compile(&quot;name=\&quot;__fp\&quot;\\s+value=\&quot;([^\&quot;]+)\&quot;&quot;);
Matcher fpMatcher = fpPattern.matcher(response);

if (fpMatcher.find()) {
    String fp = fpMatcher.group(1);
    vars.put(&quot;fp1&quot;, fp);
    log.info(&quot;Extracted __fp: &quot; + fp);
} else {
    log.info(&quot;__fp value not found&quot;);
}</stringProp>
            </BeanShellPostProcessor>
